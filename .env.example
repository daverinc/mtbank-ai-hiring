# =========================================================
# MTBank Call Analytics Pipeline — Environment Configuration
# =========================================================

# === LLM Provider ===
LLM_PROVIDER=groq                    # groq | ollama

# === Groq (внешний провайдер) ===
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# === Ollama (локальная модель) ===
OLLAMA_BASE_URL=http://localhost:11435/v1
OLLAMA_MODEL=qwen2.5:32b

# === ASR (Whisper + Diarization) ===
WHISPER_MODEL=medium
ENABLE_DIARIZATION=true
HF_TOKEN=your_huggingface_token_here
HF_HOME=./models

# === FastAPI Server ===
API_HOST=0.0.0.0
API_PORT=8000
MAX_AUDIO_SIZE_MB=50

# === OpenWebUI ===
OPENWEBUI_URL=http://localhost:9090

# === Logging ===
LOG_LEVEL=INFO