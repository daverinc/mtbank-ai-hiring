# Dockerfile.openwebui
FROM ghcr.io/open-webui/open-webui:main

# Устанавливаем системные зависимости
RUN apt-get update && apt-get install -y \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

# Копируем requirements
COPY requirements-wui.txt /app/requirements-wui.txt

# === Важно: Устанавливаем CPU-версию PyTorch ===
RUN pip install torch==2.4.1+cpu torchvision==0.19.1+cpu torchaudio==2.4.1+cpu \
    --index-url https://download.pytorch.org/whl/cpu

# Устанавливаем остальные зависимости
RUN pip install -r /app/requirements-wui.txt

# Копируем проект
COPY . /app/project

# Копируем Pipeline
COPY pipelines/0_pipeline.py /app/backend/pipelines/0_pipeline.py

# Устанавливаем PYTHONPATH
ENV PYTHONPATH=/app/project

# Отключаем генерацию заголовков (для стабильности)
ENV ENABLE_TITLE_GENERATION=false

# === Отключаем torchcodec (чтобы избежать ошибок с CUDA) ===
ENV TORCHCODEC_DISABLE=1